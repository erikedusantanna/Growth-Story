; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can be edited by hand.

config_version=5

[application]

config/name="A Growth Story"
config/description="Tycoon mobile: comece como freelancer e construa a agência de marketing dos seus sonhos."
run/main_scene="res://src/ui/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.png"

[autoload]

EventBus="*res://src/core/event_bus.gd"
Game="*res://src/core/game_manager.gd"
Audio="*res://src/core/audio_manager.gd"

[display]

window/size/viewport_width=540
window/size/viewport_height=960
; janela do desktop: 1620x960 dá viewport 1620x960 em escala 1,0 (pixel art sem borrar),
; porque canvas_items+expand fixa a altura da base e estica a largura. Ignorado no Android.
window/size/window_width_override=1620
window/size/window_height_override=960
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
